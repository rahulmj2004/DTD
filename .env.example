# Copy to .env.local and fill in. Never commit real values.

# Public origin of the deployed site (used for canonical and Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (registration storage) ---------------------------------------
# Project Settings → API. The service-role key is SERVER ONLY: it bypasses
# Row Level Security and must never be exposed with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (₹1,000 registration fee) -------------------------------------
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret for https://<your-domain>/api/payment/webhook
# (events: payment.captured, payment.failed). Optional but recommended.
RAZORPAY_WEBHOOK_SECRET=
